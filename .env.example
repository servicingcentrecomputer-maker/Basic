# Copy to .env and adjust for your environment. The server reads these at startup.

# API + production web server port (Vite dev proxy targets 3001).
PORT=3001

# Set to "production" when deploying the built site.
# NODE_ENV=production

# Set to "true" only when running behind a trusted reverse proxy (nginx, Caddy, etc.).
# TRUST_PROXY=false

# Extra origins allowed to POST to /api/contact, comma separated.
# Same-origin requests are allowed automatically.
# ALLOWED_ORIGINS=https://jordanellis.studio

# Optional overrides for the content file and enquiry storage location.
# SITE_CONTENT_PATH=./data/site.json
# SUBMISSIONS_DIR=./data/submissions

# Set to 1 only for local load testing. Never enable in production.
# DISABLE_RATE_LIMIT=0
